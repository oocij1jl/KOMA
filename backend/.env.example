# backend/config.py의 Settings가 이 파일 위치(backend/.env)에서 직접 읽습니다.
# 실제 값을 채운 뒤 backend/.env로 복사해서 사용하세요 (backend/.env는 git에 커밋되지 않습니다).

# 국립중앙도서관 서지 Open API 인증키
NL_API_KEY=your_nl_api_key_here

# 도서관 정보나루 API 인증키
D4L_API_KEY=your_d4l_api_key_here

# 알라딘 상품 API(ItemLookUp) TTBKey — 부제·원제·쪽수·판형 보완용.
# 비워 두면 알라딘을 호출하지 않고 국중도 상세 페이지/교보문고에서 부제를 찾습니다.
ALADIN_TTB_KEY=your_aladin_ttb_key_here

# OpenAI API 키 및 모델
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# 현재 미사용 (예약된 설정값)
GEMINI_API_KEY=
